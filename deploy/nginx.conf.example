# Replace the domain and certificate paths before enabling this site.
# Run Gunicorn on 127.0.0.1:8000 with DJANGO_TRUST_PROXY_HEADERS=true.
server {
    listen 80;
    server_name churn.example.com;
    return 301 https://churn.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name churn.example.com;

    ssl_certificate /etc/letsencrypt/live/churn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/churn.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # Overwrite client input; Django trusts this only when explicitly enabled.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
